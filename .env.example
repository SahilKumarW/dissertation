# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# SECRETS ONLY. Model identifiers, base URLs and decoding parameters are
# experimental parameters and belong in configs/models.yaml and configs/apis.yaml
# so they can be committed, hashed and reproduced.

# NVIDIA NIM / integrate.api.nvidia.com
NVIDIA_API_KEY=

# Google AI Studio, for the gemini_* profiles -- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LINZ Data Service -- https://data.linz.govt.nz/my/api/
LINZ_API_KEY=

# Google Maps Platform (step 6, secondary validation only)
GOOGLE_MAPS_API_KEY=
