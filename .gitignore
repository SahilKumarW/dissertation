# Environment and secrets
.env
.env.*
!.env.example

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing and static analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter / IDE files
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo

# Build / distribution artefacts
build/
dist/
*.egg-info/
*.egg

# Logs
*.log

# Supplier data is not redistributed through the repository.
data/source/*
!data/source/.gitkeep

# Generated raw LINZ downloads
data/linz/raw/*
!data/linz/raw/.gitkeep

# Generated ChromaDB database files (index manifest retained for provenance)
data/chroma/
!data/chroma/index_manifest.json

# Machine-specific: generated locally by scripts/freeze.py
experiments/freeze_manifest.json
